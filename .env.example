# URL base del backend en Railway (sin slash final)
API_URL=https://sentinelfacebackend-production.up.railway.app/api

# Número de frames enviados por reconocimiento (recomendado: 4-6)
N_FRAMES=5

# Segundos de espera entre reconocimientos para la misma cámara
COOLDOWN=4.0

# Frames consecutivos con cara detectada antes de disparar reconocimiento
FACE_STABLE_THRESHOLD=8

# Resolución de captura (ancho x alto)
CAP_WIDTH=640
CAP_HEIGHT=480

# Calidad JPEG de los frames enviados al backend (0-100)
JPEG_QUALITY=85

# Timeout en segundos para las peticiones HTTP al backend
REQUEST_TIMEOUT=20
